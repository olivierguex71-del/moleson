# Modèle de configuration Moléson.
# Copier en `.env` et compléter. Le fichier `.env` n'est JAMAIS commité (nLPD).
#
#   cp .env.example .env
#
# Générer une clé secrète Django :
#   docker compose run --rm app python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# Générer une clé de chiffrement de champ (No AVS) :
#   docker compose run --rm app python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=changeme-dev-uniquement
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Requis dès qu'on sert en HTTPS derrière un reverse proxy :
# DJANGO_CSRF_TRUSTED_ORIGINS=https://moleson.example.ch

# --- Base de données ------------------------------------------------------
# En dev, l'hôte `db` est le service Postgres de compose.yaml.
DATABASE_URL=postgres://moleson:moleson@db:5432/moleson

# Utilisés uniquement pour initialiser le conteneur Postgres de développement.
POSTGRES_DB=moleson
POSTGRES_USER=moleson
POSTGRES_PASSWORD=moleson

# --- Chiffrement des champs sensibles (nLPD) ------------------------------
# Liste de clés Fernet séparées par des virgules. La PREMIÈRE sert à chiffrer ;
# les suivantes ne servent qu'à déchiffrer l'existant (rotation de clé).
# Perdre ces clés rend les No AVS chiffrés définitivement illisibles.
MOLESON_ENCRYPTION_KEYS=

# --- Email ----------------------------------------------------------------
# En dev, les messages sont écrits dans la console.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=Moléson <noreply@unipopfr.ch>
# Production (exemple Infomaniak) :
# EMAIL_URL=submission://utilisateur:motdepasse@mail.infomaniak.com:587

# --- Accounto (Phase 0 / Phase 2) ----------------------------------------
ACCOUNTO_BASE_URL=
ACCOUNTO_API_KEY=

# --- Déploiement VPS (compose.prod.yaml uniquement) -----------------------
# Domaine servi par Caddy, qui obtient seul le certificat Let's Encrypt.
# MOLESON_DOMAIN=moleson.unipopfr.ch
# MOLESON_IMAGE=ghcr.io/unipopfr/moleson:latest
